{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "identifier": "io.github.kiramei.baas-tauri",
  "productName": "BAAS Tauri",
  "app": {
    "windows": [
      {
        "title": "BlueArchiveAutoScript",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 684,
        "devtools": true,
        "visible": true,
        "theme": null,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 22
        }
      }
    ]
  },
  "bundle": {
    "icon": [
      "icons/macos/icon.icns"
    ],
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": "packages/macos/entitlements.plist",
      "dmg": {
        "background": "packages/macos/background.png",
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "height": 400,
          "width": 660
        },
        "windowPosition": {
          "x": 200,
          "y": 180
        }
      },
      "bundleVersion": "1.95.3",
      "infoPlist": "packages/macos/release-version.plist"
    }
  }
}
