{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "baas-tauri",
  "version": "0.1.0",
  "identifier": "com.kiramei.baas-tauri",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8191",
    "beforeDevCommand": "bun dev:tauri",
    "beforeBuildCommand": "bun build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "Blue Archive Auto Script",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 640,
        "devtools": true,
        "visible": false,
        "theme": null
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "licenseFile": "../LICENSE",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "nsis": {
        "headerImage": "./packages/windows/assets/nsiHeader.bmp",
        "sidebarImage": "./packages/windows/assets/nsiSidebar.bmp",
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English", "Japanese", "Korean"],
        "installerIcon": "./packages/windows/assets/installer.ico",
        "uninstallerIcon": "./packages/windows/assets/uninstaller.ico",
        "compression": "lzma",
        "displayLanguageSelector": true,
        "template": "./packages/windows/installer.nsi"
      },
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
