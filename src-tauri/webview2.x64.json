{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "identifier": "io.github.kiramei.baas-tauri",
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "fixedRuntime",
        "path": "./Microsoft.WebView2.FixedVersionRuntime.133.0.3065.92.x64/"
      },
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["SimpChinese", "English", "Japanese", "Korean"],
        "installMode": "perMachine",
        "compression": "lzma",
        "template": "./packages/windows/installer.nsi",
        "headerImage": "./packages/windows/assets/nsiHeader.bmp",
        "sidebarImage": "./packages/windows/assets/nsiSidebar.bmp",
        "installerIcon": "./packages/windows/assets/installer.ico",
        "uninstallerIcon": "./packages/windows/assets/uninstaller.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://baas-cdn.kiramei.workers.dev/https://github.com/Kiramei/baas-tauri/releases/download/updater/update-fixed-webview2-proxy.json",
        "https://github.com/Kiramei/baas-tauri/releases/download/updater/update-fixed-webview2.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0NzNGODlERTkxNUJDMDEKUldRQnZCWHBuZmh6eERYUWs0dFowYUNYcFRFNmZIZGk5WStWZWI3Z0dGRmphQnFNbFM2MHhpTloK"
    }
  }
}
