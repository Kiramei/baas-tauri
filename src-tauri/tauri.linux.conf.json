{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "identifier": "io.github.kiramei.baas-tauri",
  "app": {
    "windows": [
      {
        "title": "BlueArchiveAutoScript",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 684,
        "devtools": true,
        "visible": true,
        "theme": null,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "linux": {
      "deb": {
        "depends": ["openssl", "libayatana-appindicator3-1"],
        "desktopTemplate": "./packages/linux/baas-tauri.desktop",
        "provides": ["baas-tauri"],
        "conflicts": ["baas-tauri"],
        "replaces": ["baas-tauri"]
      },
      "rpm": {
        "depends": ["openssl", "libayatana-appindicator-gtk3"],
        "desktopTemplate": "./packages/linux/baas-tauri.desktop",
        "provides": ["baas-tauri"],
        "conflicts": ["baas-tauri"],
        "obsoletes": ["baas-tauri"]
      }
    }
  }
}
