{
  "name": "@baas/baax",
  "version": "0.1.0",
  "description": "Independent BAAS automation terminal",
  "license": "GPL-3.0-only",
  "type": "module",
  "bin": {
    "baax": "bin/baax.mjs"
  },
  "files": [
    "bin",
    "dist/baax.js",
    "packs",
    "README.md",
    "LICENSE",
    "runtime"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "build:binary": "bun scripts/build.ts --binary",
    "check": "tsc -p tsconfig.json",
    "test": "bun test tests",
    "pack": "bun pm pack --destination dist --ignore-scripts",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@baas/client": "workspace:*",
    "@types/bun": "^1.4.4",
    "@types/react": "19.1.16",
    "ajv": "^8.20.0",
    "chalk": "5.6.2",
    "ink": "6.3.1",
    "react": "19.1.1"
  }
}
