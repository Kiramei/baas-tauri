{
  "name": "@baas/cli",
  "version": "0.1.0",
  "description": "Independent BAAS terminal and automation agent",
  "license": "GPL-3.0-only",
  "type": "module",
  "bin": {
    "baas": "bin/baas.mjs"
  },
  "files": [
    "bin",
    "dist/baas.js",
    "packs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outfile=dist/baas.js",
    "build:binary": "bun build src/index.ts --compile --outfile=dist/baas",
    "check": "tsc -p tsconfig.json",
    "test": "bun test tests",
    "pack": "bun pm pack --destination dist --ignore-scripts",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "2.0.87",
    "@baas/client": "workspace:*",
    "@types/bun": "^1.4.4",
    "ai": "6.0.317",
    "ajv": "^8.20.0"
  }
}
